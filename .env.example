# ===== openai-compat-mcp 配置 =====
# 任意 OpenAI 兼容网关地址（取消注释替换成你的）
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_BASE_URL=http://localhost:8047/v1   # 自建 vLLM / one-api 网关

# 网关密钥
OPENAI_API_KEY=sk-xxxx

# 默认模型（可被工具参数 model 覆盖）
MODEL=gpt-4o-mini
# MODEL=deepseek-chat
# MODEL=glm-4-flash
